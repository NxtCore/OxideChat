# Copy to e2e/.env (gitignored). Bun loads it automatically when the suite runs.
# Without E2E_LLM_API_KEY the suite falls back to the local stand-in provider in scripts/mock-llm.mjs.

# Provider kind as stored by OxideChat: OPENROUTER, OPENAI, OPENAI_COMPAT, ANTHROPIC, GOOGLE
E2E_LLM_KIND=OPENROUTER
E2E_LLM_BASE_URL=https://openrouter.ai/api
E2E_LLM_API_KEY=
# Upstream model id; matched against the synced model ids by suffix.
# Pick a cheap model WITHOUT reasoning and WITH catalog pricing.
E2E_LLM_MODEL=openai/gpt-4o-mini
