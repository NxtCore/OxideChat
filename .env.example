# PostgreSQL connection (required: POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oxidechat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Public URL users open, used for OAuth redirects. Session cookies are marked Secure
# unless this starts with http://, so use https:// in production.
BASE_URL=http://localhost:8080

# Credential encryption key (64 hex characters, generate with: openssl rand -hex 32).
# If unset, a key is generated in OXIDECHAT_DATA_DIR/master.key. Losing the key makes
# stored provider API keys and OAuth secrets unreadable, so back it up either way.
# ENCRYPTION_KEY=your_64_character_hex_key_here
# The Docker image uses /app/data (mount it as a volume).
OXIDECHAT_DATA_DIR=./.data

# Image storage: database (default) or file. File storage writes to IMAGE_STORAGE_PATH
# (default ./uploads/images, /app/uploads/images in the Docker image).
IMAGE_STORAGE_TYPE=database
# IMAGE_STORAGE_PATH=./uploads/images

# Log filter, default: info,omniference=debug
# RUST_LOG=info

# Sign-in providers on a private network (for example a self-hosted Keycloak) are refused unless this is true.
# Link-local and cloud metadata addresses are always refused.
OIDC_ALLOW_PRIVATE_HOSTS=false

# Pre-authentication rate limits in requests per minute (0 disables a limit).
# Applied per client IP to login/register/setup and the OAuth routes.
AUTH_RATE_LIMIT_PER_MINUTE=20
# Applied per client IP to every gateway request, before the API key is verified.
GATEWAY_PRE_AUTH_IP_LIMIT_PER_MINUTE=120
# Failed authentications allowed per API key ID; once reached, requests naming that key are
# refused until the minute is over. Requests with the right secret do not count.
GATEWAY_PRE_AUTH_KEY_LIMIT_PER_MINUTE=60

# --- Reverse proxy (Docker image) ---
# Addresses or ranges your TLS proxy connects from, comma-separated. Only these may set the client IP
# through X-Forwarded-For. Empty: the header is ignored and every request counts as the proxy's address,
# so all clients share the per-IP rate limits.
TRUSTED_PROXIES=

# --- Only when running the binary without the Docker image ---
# The image always listens on 8080 and sets these itself.
HOST=0.0.0.0
PORT=8080
# Set to true only when a trusted reverse proxy sits in front and overwrites
# X-Forwarded-For; the client IP is then its first value. Default: false.
TRUST_PROXY=false
