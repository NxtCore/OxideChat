POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oxidechat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

HOST=0.0.0.0
PORT=8080
BASE_URL=http://localhost:8080

# OAuth Configuration (optional - can also be configured via admin UI)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=

# Credential encryption
# A key is generated automatically in OXIDECHAT_DATA_DIR/master.key.
OXIDECHAT_DATA_DIR=./.data
# For containers or multiple replicas, provide the same explicit 64-character hex key to every instance.
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=your_64_character_hex_key_here

# Set to true only when OxideChat runs behind a trusted reverse proxy
# (nginx, Caddy, ...). The client IP for rate limiting is then taken from
# the first X-Forwarded-For value. Default: false (the header is ignored).
TRUST_PROXY=false

# Pre-authentication rate limits in requests per minute (0 disables a limit).
# Applied per client IP to login/register/setup and the OAuth routes.
AUTH_RATE_LIMIT_PER_MINUTE=20
# Applied per client IP and per API-key prefix to gateway authentication,
# before any password verification runs.
GATEWAY_PRE_AUTH_IP_LIMIT_PER_MINUTE=120
GATEWAY_PRE_AUTH_KEY_LIMIT_PER_MINUTE=60

# Session cookies are marked Secure by default (sent only over HTTPS).
# Set to false ONLY for plain-HTTP local setups, never in production.
COOKIE_SECURE=true
